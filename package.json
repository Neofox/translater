{
  "name": "neotranslate",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test e2e/perf/gateway.test.ts e2e/perf/requests.test.ts e2e/perf/throttleProxy.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "e2e": "playwright test -c e2e",
    "e2e:visual": "node e2e/visual/run.mjs",
    "e2e:visual:update": "node e2e/visual/run.mjs --update",
    "eval:quality": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env.local",
    "eval:quality:fresh": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env.local --no-cache",
    "eval:quality:repeat": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env.local --repeat 3",
    "eval:injection": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env.local --filter-pattern ^injection",
    "eval:ci": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/ci.promptfooconfig.yaml --env-file .env.local",
    "eval:progress": "node evals/progress.mjs",
    "eval:summary": "node evals/summary.mjs",
    "eval:view": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo view"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "lucide-static": "1.61.0",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "promptfoo": "0.125.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "undici": "7.30.1"
  },
  "packageManager": "npm@11.17.0"
}
