{
  "name": "transater",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .vercel/server/index.mjs",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "typecheck": "tsc --noEmit",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:ui": "vitest --config vitest.browser.config.ts --ui",
    "test:browser:report": "vite preview --config vitest.browser.config.ts --outDir test-results/browser --port 4175",
    "eval:quality": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env.local",
    "eval:quality:fresh": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env.local --no-cache",
    "eval:quality:repeat": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env.local --repeat 3",
    "eval:injection": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --env-file .env.local --filter-pattern ^injection",
    "eval:ci": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/ci.promptfooconfig.yaml --env-file .env.local",
    "eval:progress": "node evals/progress.mjs",
    "eval:summary": "node evals/summary.mjs",
    "eval:view": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo view"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@langfuse/otel": "6.0.2",
    "@langfuse/vercel-ai-sdk": "6.0.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/router-plugin": "1.168.48",
    "@vercel/analytics": "2.0.1",
    "ai": "7.0.153",
    "lucide-react": "1.61.0",
    "nitro": "3.0.260903-beta",
    "partial-json": "0.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tinyld": "1.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/ui": "5.0.5",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "promptfoo": "0.125.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "undici": "7.30.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "packageManager": "npm@11.17.0"
}
