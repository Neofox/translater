# Upload only what the Go build needs: the module (go.mod, *.go, cmd/,
# internal/, web/) and the embedded contract (shared/translation). The npm
# tooling (e2e suite, evals) never runs on Vercel; without package.json the
# deployment cannot mistake the repository for a Node project.
node_modules
package.json
package-lock.json
.DS_Store
*.local
.env
.env*
.vercel
test-results/
.promptfoo-cache/
e2e/
evals/
docs/
.github/

# Local agent and review artifacts
.claude/
.agents/
.superpowers/
.codegraph/
.headroom/
.serena/
