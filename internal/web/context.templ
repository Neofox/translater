package web

import (
	"neotranslate/internal/web/icons"
	"neotranslate/internal/web/ui"
	"strconv"
)

// contextToggle is ContextField.tsx's ContextToggle. Its tone follows the
// sessionStorage context (client-only): context.js swaps the class between
// the rendered neutral string and data-active-class, both from ui.PillClass.
templ contextToggle(v View) {
	@ui.Pill(ui.PillProps{Size: "md", Class: "context-toggle", Attrs: templ.Attributes{
		"aria-expanded": "false", "aria-label": v.T("contextToggle"), "title": v.T("contextToggle"),
		"data-t-attr": "aria-label:contextToggle title:contextToggle", "data-testid": "context-toggle",
		"data-active-class": ui.PillClass("active", "md", "context-toggle"),
	}}) {
		@icons.Icon("reply", 18, nil)
		<span class="context-toggle-label" data-t="contextToggle">{ v.T("contextToggle") }</span>
		<span class="context-toggle-short-label" data-t="contextShort">{ v.T("contextShort") }</span>
	}
}

// contextField is InputPanel's composer-context with ContextTextarea, as a
// template. TS mounts it only while open, and base.css selects on its
// presence (.composer:has(.composer-context)), so even a hidden copy would
// change the composer grid. context.js clones it once and inserts/removes
// that node, which keeps the draft. The clear button stays mounted with
// `hidden` (TS unmounts it while the context is empty).
templ contextField(v View) {
	<template id="context-field">
		<div class="composer-context">
			<div class="context-field">
				<textarea maxlength={ strconv.Itoa(v.Contract.Limits.MaxContextChars) } placeholder={ v.T("contextPlaceholder") } aria-label={ v.T("contextToggle") } data-t-attr="placeholder:contextPlaceholder aria-label:contextToggle" data-testid="context-textarea" class="field-sizing-content max-h-24 min-h-12 w-full resize-none bg-transparent px-4 py-2 pr-12 text-sm leading-relaxed text-ink placeholder:text-ink-dim focus:outline-none scrollbar-thin"></textarea>
				<button type="button" aria-label={ v.T("contextClear") } data-t-attr="aria-label:contextClear" data-testid="context-clear" class="absolute right-1 top-1 inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded text-ink transition hover:text-accent" hidden>
					@icons.Icon("x", 12, nil)
				</button>
			</div>
		</div>
	</template>
}
