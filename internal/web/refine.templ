package web

import (
	"neotranslate/internal/web/icons"
	"neotranslate/internal/web/ui"
)

// refineChips are REFINEMENT_CHIPS (src/lib/refinements.ts): id and label
// key. The model-facing instructions live in refine.js.
var refineChips = []struct{ ID, Key string }{
	{"softer", "refineSofter"}, {"direct", "refineMoreDirect"},
	{"shorter", "refineShorter"}, {"playful", "refineMorePlayful"},
}

// refineRow is RefineRow.tsx. Both custom variants stay mounted: the active
// custom button, or the trigger with its editor (TS renders one of them);
// refine.js shows one and keeps every control's state.
templ refineRow(v View) {
	<div class="refine-row">
		<p data-testid="refine-error" class="mb-2 text-xs text-red-400" hidden></p>
		<div class="refine-controls">
			<span class="refine-label" data-t="refineLabel">{ v.T("refineLabel") }</span>
			for _, c := range refineChips {
				@ui.Pill(ui.PillProps{Tone: "accent", Class: "disabled:cursor-not-allowed disabled:opacity-40", Attrs: templ.Attributes{
					"disabled": true, "aria-pressed": "false", "data-testid": "refine-chip-" + c.ID, "data-t": c.Key,
					"data-active-class": ui.PillClass("active", "sm", "disabled:cursor-not-allowed disabled:opacity-40"),
				}}) {
					{ v.T(c.Key) }
				}
			}
			@ui.Pill(ui.PillProps{Tone: "active", Attrs: templ.Attributes{
				"aria-pressed": "true", "disabled": true, "data-testid": "refine-custom", "hidden": true,
			}})
			@ui.Pill(ui.PillProps{Class: "refine-custom-trigger", Attrs: templ.Attributes{
				"aria-expanded": "false", "disabled": true, "data-testid": "refine-custom-trigger",
				"data-active-class": ui.PillClass("active", "sm", "refine-custom-trigger"),
			}}) {
				// refine.js adds the label as a bare text node (as in TS); the
				// menu is only ever inserted by refine.js.
				@icons.Icon("plus", 16, nil)
			}
			<div class="refine-custom-editor" hidden>
				<input hidden maxlength="200" disabled placeholder={ v.T("refinePlaceholder") } aria-label={ v.T("refinePlaceholder") } data-t-attr="placeholder:refinePlaceholder aria-label:refinePlaceholder" data-testid="refine-freeform" class="refine-freeform min-w-32 flex-1 bg-transparent px-2 py-1 text-xs text-ink placeholder:text-ink-dim focus:outline-none disabled:cursor-not-allowed disabled:opacity-40"/>
				@ui.Pill(ui.PillProps{Tone: "accent", Attrs: templ.Attributes{"data-testid": "refine-apply", "disabled": true, "data-t": "refineApply"}}) {
					{ v.T("refineApply") }
				}
				@ui.Pill(ui.PillProps{Attrs: templ.Attributes{
					"aria-label": v.T("refineClose"), "title": v.T("refineClose"),
					"data-t-attr": "aria-label:refineClose title:refineClose", "data-testid": "refine-close",
				}}) {
					@icons.Icon("x", 18, nil)
				}
			</div>
		</div>
	</div>
}
