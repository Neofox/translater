package web

// inputPanel is InputPanel.tsx. The textarea belongs to no form and sits
// outside every swap target: runs copy its trimmed text into
// #translate-form, so streaming and preference swaps never touch it.
templ inputPanel(v View) {
	<section class="input-panel" aria-label={ v.T("sourceText") } data-t-attr="aria-label:sourceText">
		<div class="composer">
			<div class="composer-header">
				@LanguageBar(v, "source")
			</div>
			<div class="composer-field">
				<div class="source-input-area">
					<textarea rows="1" placeholder={ v.T("placeholder") } aria-label={ v.T("inputText") } data-t-attr="placeholder:placeholder aria-label:inputText" data-testid="input-textarea" class="translation-input scrollbar-thin" spellcheck="true" autocomplete="off" autocorrect="on"></textarea>
				</div>
				<div class="composer-actions">
					<button type="button" aria-label={ v.T("pasteClipboard") } data-t-attr="aria-label:pasteClipboard" data-testid="paste-input" data-input-action="true" class={ pill("primary", "md", "paste-button") }>
						@iconClipboard(16)
						<span data-t="paste">{ v.T("paste") }</span>
					</button>
					<button type="button" title={ v.T("clearInputTitle") } aria-label={ v.T("clearInput") } data-t-attr="title:clearInputTitle aria-label:clearInput" data-testid="clear-input" data-input-action="true" class={ pill("neutral", "md", "clear-button") }>
						@iconX(16)
						<span data-t="clear">{ v.T("clear") }</span>
					</button>
				</div>
				<div class="composer-meta">
					<span class="input-count text-ink-dim">{ v.inputCount() }</span>
				</div>
			</div>
		</div>
	</section>
}

// translateForm carries one run's fields; app.js fills them and triggers
// nt-run. hx-sync replace aborts the previous run's request.
templ translateForm() {
	<form id="translate-form" hx-post="/translate" hx-trigger="nt-run" hx-sync="this:replace" hx-swap="none" hidden>
		for _, name := range []string{"run", "text", "source", "target", "mode", "intent", "uiLang", "context", "previousMain", "refinements"} {
			<input type="hidden" name={ name }/>
		}
	</form>
}

// prefsForm posts the preferences for the re-rendered chip bars.
templ prefsForm(v View) {
	<form id="prefs-form" hx-post="/prefs" hx-trigger="nt-prefs" hx-sync="this:replace" hx-swap="none" hidden>
		for _, f := range v.Contract.Prefs.Fields {
			<input type="hidden" name={ f.Key }/>
		}
	</form>
}
