package web

// LanguageBar is LanguageChipBar.tsx: every chip renders (CSS container
// queries hide inactive chips on narrow bars) plus the More… trigger. The
// listbox is empty until opened (prefs.js fills it), so only one set of
// options ever exists in the DOM. POST /prefs re-renders both bars.
templ LanguageBar(v View, kind string) {
	<div role="group" id={ kind + "-bar" } aria-label={ v.T(kind + "Language") } data-kind={ kind } class="language-chip-bar flex min-w-0 flex-1 items-center gap-1.5">
		<div class="language-chip-scroll flex min-w-0 items-center gap-1.5 overflow-x-auto">
			for _, c := range v.chips(kind) {
				<button type="button" aria-pressed={ boolString(c.Pressed) } data-testid="lang-chip" data-value={ c.Code } aria-label={ c.Label } class={ pill(chipTone(c.Pressed), "md", "language-chip") }>
					<span class="sr-only">{ c.Label }</span><span aria-hidden="true">{ c.Short }</span>
				</button>
			}
		</div>
		<button type="button" aria-label={ v.T("moreLanguages") } aria-expanded="false" data-testid="lang-more-trigger" aria-haspopup="listbox" role="combobox" popovertarget={ kind + "-more" } class={ pill("neutral", "md", "") }>
			<span>{ v.T("moreLabel") }</span>
			@iconChevronDown(12, " transition-transform")
		</button>
		<ul id={ kind + "-more" } popover role="listbox" aria-label={ v.T("moreLanguages") } data-kind={ kind } class="z-50 overflow-auto rounded-lg border border-border bg-panel py-1 text-sm text-ink shadow-lg scrollbar-thin focus:outline-none"></ul>
	</div>
}

// langOption is the template prefs.js clones for each listbox option
// (Select.tsx option markup).
templ langOption() {
	<template id="lang-option">
		<li>
			<button type="button" role="option" aria-selected="false" data-testid="select-option" class="flex w-full cursor-pointer items-center justify-between gap-4 px-3 py-1.5 text-left transition hover:bg-panel-2 focus:bg-panel-2 focus:outline-none text-ink">
				<span></span>
				@iconCheck(14, " text-accent")
			</button>
		</li>
	</template>
}

// Bars is the POST /prefs response: both chip bars as morph partials.
templ Bars(v View) {
	<hx-partial hx-target="#source-bar" hx-swap="outerMorph">
		@LanguageBar(v, "source")
	</hx-partial>
	<hx-partial hx-target="#target-bar" hx-swap="outerMorph">
		@LanguageBar(v, "target")
	</hx-partial>
}
