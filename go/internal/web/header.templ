package web

import (
	"neotranslate/internal/web/icons"
	"neotranslate/internal/web/ui"
)

// Header (TranslatorWorkspace.tsx app-header): brand, Tone (ModeToggle.tsx)
// and the Settings trigger (SettingsMenu.tsx). Labels carry data-t keys so
// prefs.js relabels them on a UI-language switch without a swap.
templ header(v View) {
	<header class="app-header">
		<div class="app-brand">
			<span class="brand-glyph" aria-hidden="true">가</span>
			<h1>Translater</h1>
		</div>
		<div class="app-settings">
			<div class="mode-segment" role="group" aria-label={ v.T("tone") } data-t-attr="aria-label:tone">
				for _, m := range modes {
					<button type="button" data-value={ m.Value } aria-pressed={ boolString(v.Prefs.Mode == m.Value) } data-t={ m.Key }>{ v.T(m.Key) }</button>
				}
			</div>
			<select class="mode-select" aria-label={ v.T("tone") } data-t-attr="aria-label:tone">
				for _, m := range modes {
					<option value={ m.Value } selected?={ v.Prefs.Mode == m.Value } data-t={ m.Key }>{ v.T(m.Key) }</option>
				}
			</select>
			@ui.Pill(ui.PillProps{Size: "md", Class: "settings-trigger", Attrs: templ.Attributes{
				"aria-label": v.T("settings"), "data-t-attr": "aria-label:settings", "data-testid": "settings-button",
				"aria-haspopup": "dialog", "popovertarget": "settings-popover",
			}}) {
				@icons.Icon("settings", 18, nil)
			}
		</div>
	</header>
}

// settingsPopover is SettingsMenu's floating panel; it lives at the end of
// <body> (FloatingPortal) and opens with the native popover API. The
// "UI language" label stays English in both UI languages (UiLangToggle.tsx).
// The buttons carry UiLangToggle's idle class; go.css styles the pressed one
// from [aria-pressed], so a client-side switch needs no class changes.
templ settingsPopover(v View) {
	<div id="settings-popover" popover class="settings-popover" role="dialog" aria-label={ v.T("settings") } data-t-attr="aria-label:settings">
		<h2 data-t="settings">{ v.T("settings") }</h2>
		<div class="inline-flex rounded-md border border-border bg-panel p-0.5 text-xs" role="group" aria-label="UI language">
			for _, l := range []struct{ Code, Label string }{{"en", "EN"}, {"ko", "한"}} {
				<button type="button" data-ui-lang={ l.Code } aria-pressed={ boolString(v.Prefs.UILang == l.Code) } class="cursor-pointer rounded px-2 py-0.5 font-semibold tracking-wide transition text-ink-soft hover:text-ink">{ l.Label }</button>
			}
		</div>
	</div>
}

func boolString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
