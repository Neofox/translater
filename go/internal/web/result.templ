package web

import (
	"strconv"

	"neotranslate/internal/web/icons"
	"neotranslate/internal/web/ui"
)

// Result fragments streamed by /translate as <hx-partial> swaps. Markup,
// class strings and data-testids follow the TS components (SentenceView /
// WordView ResultSection, AlternativeItem, Pill, Tag) so the carried-over CSS
// styles them identically. templ escapes all model text.

// ResultSkeleton is the content of #result-details at the start of a run:
// the always-open alternatives section with an empty #alternatives list that
// AlternativeRow partials are appended to. The section stays mounted while
// empty (TS unmounts it); CSS hides it until it holds an alternative item.
templ ResultSkeleton(title string) {
	<section class="result-section detail-alternatives" aria-labelledby="alternatives-title">
		<h3 id="alternatives-title" class="result-section-title"><span>{ title }</span></h3>
		<div id="alternatives-body" class="result-section-body">
			<ul id="alternatives" class="alternative-list"></ul>
		</div>
	</section>
}

// AlternativeRow is one completed alternative (AlternativeItem.tsx). Word
// rows always use the wrapper with register tags: WordView passes children
// (an array, truthy even when empty). The Copy button renders disabled; the
// client enables it once the whole current result has completed.
templ AlternativeRow(index int, word bool, text, note string, registers []string, copyLabel string) {
	<li data-testid="alternative-item" class="alternative-item detail-enter group flow-root rounded-lg border border-border bg-panel px-3 py-2" style={ templ.SafeCSS("animation-delay: " + strconv.Itoa(index*40) + "ms") }>
		if text != "" {
			<div class="alternative-actions float-right ml-2 inline-flex items-center gap-1.5">
				@ui.Pill(ui.PillProps{Class: "copy-button icon-action disabled:cursor-not-allowed disabled:opacity-45", Attrs: templ.Attributes{
					"aria-label": copyLabel, "title": copyLabel, "data-testid": "copy-button", "disabled": true,
				}}) {
					@icons.Icon("copy", 14, nil)
				}
			</div>
		}
		if word {
			<div class="flex flex-wrap items-baseline gap-2">
				<p class="alternative-text min-w-0 break-words text-ink">{ text }</p>
				for _, r := range registers {
					@ui.Tag("neutral") {
						{ r }
					}
				}
			</div>
		} else {
			<p class="alternative-text whitespace-pre-wrap break-words text-ink">{ text }</p>
		}
		if note != "" {
			<p class="alternative-note text-ink-soft">{ note }</p>
		}
	</li>
}
