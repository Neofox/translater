package web

import "strconv"

// Lucide icons as rendered by lucide-react (same attributes and paths).
// Stage 3 replaces these with lucide-static.

templ svgOpen(name string, size int, extra string) {
	<svg xmlns="http://www.w3.org/2000/svg" width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={ "lucide lucide-" + name + extra } aria-hidden="true">
		{ children... }
	</svg>
}

templ iconSettings(size int) {
	@svgOpen("settings", size, "") {
		<path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path><circle cx="12" cy="12" r="3"></circle>
	}
}

templ iconSwap(size int) {
	@svgOpen("arrow-right-left", size, "") {
		<path d="m16 3 4 4-4 4"></path><path d="M20 7H4"></path><path d="m8 21-4-4 4-4"></path><path d="M4 17h16"></path>
	}
}

templ iconLoader(size int, extra string) {
	@svgOpen("loader-circle", size, extra) {
		<path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
	}
}

templ iconChevronDown(size int, extra string) {
	@svgOpen("chevron-down", size, extra) {
		<path d="m6 9 6 6 6-6"></path>
	}
}

templ iconCopy(size int) {
	@svgOpen("copy", size, "") {
		<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
	}
}

templ iconVolume(size int) {
	@svgOpen("volume-2", size, "") {
		<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path><path d="M16 9a5 5 0 0 1 0 6"></path><path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path>
	}
}

templ iconClipboard(size int) {
	@svgOpen("clipboard", size, "") {
		<rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
	}
}

templ iconX(size int) {
	@svgOpen("x", size, "") {
		<path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
	}
}

templ iconAlert(size int, extra string) {
	@svgOpen("triangle-alert", size, extra) {
		<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path>
	}
}

templ iconCheck(size int, extra string) {
	@svgOpen("check", size, extra) {
		<path d="M20 6 9 17l-5-5"></path>
	}
}
