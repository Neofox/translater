# Vercel AI Gateway is the only model-provider path. Vercel Functions receive
# request-scoped OIDC automatically, while `vercel env run` injects OIDC for
# local commands. This static key is an optional fallback for external runtimes.
AI_GATEWAY_API_KEY=
TRANSLATE_MODEL=openai/gpt-6-luna

# ---- Optional Langfuse observability (server-only) ----
# AI SDK telemetry records operational metadata only; translation inputs and
# outputs are disabled at the call boundary. Both credentials are required.
# Use the base URL shown by the Langfuse project for its selected data region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=<git-sha-or-release-id>
