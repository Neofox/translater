# OpenAI is the only provider. On Vercel, set these as Project Environment Variables.
OPENAI_API_KEY=sk-...
TRANSLATE_MODEL=gpt-5.6-luna

# ---- Pricing for the debug-bar cost readout (per 1M tokens, USD) ----
# The debug bar prices ordinary input, cached reads, cache writes, and output
# separately. Update these to match your model. Omit base input/output to hide cost.
TRANSLATE_PRICE_INPUT_PER_1M=1.00
TRANSLATE_PRICE_CACHED_INPUT_PER_1M=0.10
TRANSLATE_PRICE_CACHE_WRITE_INPUT_PER_1M=1.25
TRANSLATE_PRICE_OUTPUT_PER_1M=6.00

# ---- Optional Langfuse observability (server-only) ----
# Traces contain operational metadata only; translation inputs/outputs are not sent.
# Use the base URL shown by the Langfuse project for its selected data region.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=
