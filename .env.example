# Vercel AI Gateway is the only model-provider path. Vercel deployments and
# `vercel env run` use VERCEL_OIDC_TOKEN automatically; this static key is an
# optional fallback for local or external runtimes.
AI_GATEWAY_API_KEY=
TRANSLATE_MODEL=openai/gpt-5.6-luna

# ---- Optional Langfuse observability (server-only) ----
# AI SDK telemetry records operational metadata only; translation inputs and
# outputs are disabled at the call boundary. Both credentials are required.
# Use the base URL shown by the Langfuse project for its selected data region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=<git-sha-or-release-id>
