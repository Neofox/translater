# ---- Provider resolution (first match wins) ----
# Vercel deploys: set OPENAI_API_KEY (or OPENROUTER_API_KEY + TRANSLATE_MODEL)
# as Project Environment Variables — the LM Studio fallback is local-only.

# 1) OpenRouter: try any model by `vendor/name` (anthropic/claude-3.5-sonnet, google/gemini-2.5-pro, …).
#    Uncomment these and leave OPENAI_API_KEY empty to use OpenRouter.
# OPENROUTER_API_KEY=sk-or-...
# TRANSLATE_MODEL=openai/gpt-5.4-mini
# OPENROUTER_SITE_URL=http://localhost:3000  # optional, sent as HTTP-Referer header

# 2) OpenAI direct (mini reliably keeps metadata English; nano drifts).
OPENAI_API_KEY=sk-...
TRANSLATE_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=                          # optional, for Azure etc.

# 3) LM Studio fallback (used when no cloud key is set).
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen3.5-9b
LM_STUDIO_API_KEY=lm-studio

# ---- Pricing for the debug-bar cost readout (per 1M tokens, USD) ----
# Cost shown in debug bar = (in_tokens * INPUT + out_tokens * OUTPUT) / 1M.
# Update to match your actual model pricing. Omit to hide the cost field.
TRANSLATE_PRICE_INPUT_PER_1M=0.75
TRANSLATE_PRICE_OUTPUT_PER_1M=4.50
