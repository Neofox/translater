# Translation and pronunciation call OpenAI directly (no fallback, no retry).
OPENAI_API_KEY=
# One exact OpenAI model id, without an `openai/` prefix.
TRANSLATE_MODEL=gpt-6.1-terra
# none | low | medium. Hidden reasoning delays the first token and is billed.
TRANSLATE_REASONING=none
# default | fast. Fast is OpenAI's priority processing at 2x Standard price.
TRANSLATE_SERVICE_TIER=fast
# Pronunciation: OpenAI speech model and voice.
# SPEECH_MODEL=gpt-4o-mini-tts
# SPEECH_VOICE=marin

# ---- Optional Langfuse observability (server-only) ----
# Traces carry operational metadata only, never source text, prompts or
# outputs. Both credentials are required. Use the base URL shown by the
# Langfuse project for its selected data region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=<git-sha-or-release-id>
